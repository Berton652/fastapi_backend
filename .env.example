# Copy to .env and fill in. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ONEPOINT_SECRET_KEY=
ONEPOINT_DATABASE_URL=sqlite:///./onepoint.db
# Postgres (recommended beyond local dev):
# ONEPOINT_DATABASE_URL=postgresql+psycopg://onepoint:password@localhost:5432/onepoint

ONEPOINT_ACCESS_TOKEN_MINUTES=15
ONEPOINT_REFRESH_TOKEN_DAYS=30
ONEPOINT_USD_TO_SLL=22.5
ONEPOINT_NETWORK_FEE=0.01
ONEPOINT_USD_FEE=0.02
# Demo-only: lets the app credit wallets with fake money. MUST be false in production.
ONEPOINT_ALLOW_SIMULATED_TOPUP=true
